{
  "server_argv": [
    "/absolute/path/to/frozen/llama-server",
    "-m",
    "/absolute/path/to/model.gguf",
    "--host",
    "127.0.0.1",
    "--port",
    "8096",
    "--n-gpu-layers",
    "0",
    "--threads",
    "1",
    "--threads-batch",
    "1",
    "--threads-http",
    "2",
    "--ctx-size",
    "2048",
    "--parallel",
    "1",
    "--batch-size",
    "512",
    "--ubatch-size",
    "256",
    "--flash-attn",
    "off",
    "--no-ui",
    "--server-compute-profile-mode",
